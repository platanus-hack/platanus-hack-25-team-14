{
  "name": "mi-software-medico-monorepo",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "sst dev",
    "predev": "pnpm gen && pnpm gen:gql",
    "deploy": "sst deploy",
    "build": "sst build",
    "gen": "prisma generate --schema=packages/core/src/prisma/schema.prisma",
    "db:migrate": "pnpm --filter @medical-platform/core prisma migrate dev",
    "db:seed": "pnpm --filter @medical-platform/core prisma db seed",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push --schema=packages/core/src/prisma/schema.prisma",
    "gen:gql": "pnpm --filter @medical-platform/functions gen:schema && pnpm --filter web codegen"
  },
  "devDependencies": {
    "prisma": "5.19.1",
    "sst": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.19.1",
    "lucide-react": "^0.554.0"
  }
}
